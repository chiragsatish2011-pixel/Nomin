# Firebase web app configuration (Firebase Console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional internal build lane. Keep these server-side; never expose them in
# NEXT_PUBLIC_* variables. Key 1 is preferred for planning and key 2 for
# execution/review.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_EXECUTOR=gemini-3.5-flash
GEMINI_RPM_LIMIT=10
GEMINI_TPM_LIMIT=0
TRION_GEMINI_REQUEST_TIMEOUT_MS=60000
