# Trion environment template. Copy to .env.local and fill in.
# NEVER commit real keys. Server-side only; no NEXT_PUBLIC_* model keys.
# (Firebase/login keys were removed with the login system and must not be re-added.)

# --- Local model lane (PREFERRED when configured) ---
#
# Point these at any locally hosted server that speaks the OpenAI
# chat-completions shape and Trion will try it FIRST for every request:
#
#   Ollama      TRION_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
#   LM Studio   TRION_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
#   llama.cpp   TRION_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
#   vLLM        TRION_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
#
# BOTH variables are required to enable the lane. If the local server is down,
# slow, or serving a different model id, that same request falls through to the
# NVIDIA lane below without failing the user's turn. Three consecutive local
# failures park the lane for 60s so a dead port costs one connection refusal a
# minute rather than one in front of every call.
#TRION_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
#TRION_LOCAL_MODEL=qwen2.5-coder:14b
# Optional: a smaller local model for classification/synthesis/planning.
#TRION_LOCAL_FAST_MODEL=qwen2.5-coder:7b
# Optional: only if your local server requires a key (Ollama and llama.cpp do not).
#TRION_LOCAL_API_KEY=
# Optional: per-request ceiling for the local lane (default 60000).
#TRION_LOCAL_TIMEOUT_MS=60000
# Keep the configuration but stop using the lane.
#TRION_LOCAL_DISABLED=1

# --- Provider lane (OpenAI-compatible; default endpoint: NVIDIA integrate API) ---
#
# This is the FALLBACK lane when a local model is configured, and the only lane
# when one is not. ONE key. The former five-credential pool (TRION_API_KEY_1..5, TRION_API_KEYS,
# TRION_KEY_POOL_ENABLED, TRION_KEY_POOL_TOS_CONFIRMED,
# TRION_KEY_POOL_INDEPENDENT_BILLING) and the separate two-key Gemini build lane
# (GEMINI_API_KEY_1..3, GEMINI_MODEL_*, GEMINI_RPM_LIMIT, GEMINI_TPM_LIMIT,
# TRION_GEMINI_REQUEST_TIMEOUT_MS) have been removed from the codebase. Setting
# any of them now does nothing.
TRION_API_KEY=
TRION_BASE_URL=https://integrate.api.nvidia.com/v1

# Both models must exist on the endpoint above. Verify with:
#   node scripts/verify-provider.mjs
#
# PRIMARY: execution decisions and full-file code authoring. The deep-reasoning
# model — this is where code quality comes from.
TRION_MODEL_PRIMARY=nvidia/nemotron-3-ultra-550b-a55b
# FAST: classification, PLANNING, synthesis and the review chain. Planning runs
# here, so it must still be a capable model, not a throwaway tier.
TRION_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b

# Optional extra tiers (unavailable unless each names its own primary model):
#TRION_MODEL_1_9_PRIMARY=
#TRION_MODEL_1_9_FAST=
#TRION_MODEL_2_3_PRIMARY=
#TRION_MODEL_2_3_FAST=
# Optional role routing (defaults to the user-selected tier):
#TRION_PLANNER_TIER=
#TRION_EXECUTOR_TIER=
#TRION_VERIFIER_TIER=

# --- Rate / transport budgets (defaults shown) ---
# One key means one budget: RPM is the account's allowance, not a per-key one.
TRION_RPM_LIMIT=40
TRION_TPM_LIMIT=0
TRION_MIN_RPM=4
TRION_REQUEST_TIMEOUT_MS=180000
TRION_CLIENT_EXECUTION_TIMEOUT_MS=45000
TRION_CLIENT_EXECUTION_MAX_MS=180000
TRION_CIRCUIT_OPEN_MS=60000

# --- Diagnostics ---
# Logs every provider call: endpoint, model, key presence (never the key),
# HTTP status, and the raw body on failure. Set to 0 to log failures only.
TRION_DEBUG_PROVIDER=1
#TRION_PERF=1

# --- Agent loop ---
# Ask the provider to ENFORCE the executor's tool schema (OpenAI function
# calling) instead of prompting for a JSON object and parsing the reply.
# Off by default: it changes the wire format of the busiest call in the system,
# so turn it on once you have verified it against the endpoint you actually
# run. A provider that ignores `tools` degrades to the prompted-JSON path.
#TRION_EXECUTOR_TOOL_CALLS=1

# --- Product / ops flags ---
# balanced | permissive | strict (see lib/agent/approval.ts)
TRION_APPROVAL_PROFILE=balanced
#TRION_DESIGN_REVIEW=1
#TRION_BENCH=1
