# Trion 1.5 — NVIDIA Nemotron 3 Ultra 550B A55B
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Manager (monitor) — separate key so review traffic never eats the worker budget
NOMIN_SUPERVISOR_API_KEY=nvapi-...

# The doctor team — one key each, so six repairs can run without colliding
NOMIN_DOCTOR_1_API_KEY=nvapi-...
NOMIN_DOCTOR_2_API_KEY=nvapi-...
NOMIN_DOCTOR_3_API_KEY=nvapi-...
NOMIN_DOCTOR_4_API_KEY=nvapi-...
NOMIN_DOCTOR_5_API_KEY=nvapi-...
NOMIN_DOCTOR_6_API_KEY=nvapi-...
