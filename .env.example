# Trion 1.5 — NVIDIA Nemotron 3 Ultra 550B A55B
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# The Manager AI — Llama 3.2 90B Vision Instruct.
#
# A separate key so review traffic never eats the worker's budget. If this is
# unset Nomin falls back to NOMIN_VISION_API_KEY, then NVIDIA_API_KEY, and runs
# on local evidence alone only when none of the three exists — in which case
# nothing is ever approved, and the interface says so rather than implying the
# work passed a review that never happened.
NOMIN_SUPERVISOR_API_KEY=nvapi-...
# Optional. The default backend is meta/llama-3.2-90b-vision-instruct.
# NOMIN_SUPERVISOR_MODEL=meta/llama-3.2-90b-vision-instruct
# NOMIN_SUPERVISOR_URL=https://integrate.api.nvidia.com/v1

# The doctor team — one key each, so six repairs can run without colliding
NOMIN_DOCTOR_1_API_KEY=nvapi-...
NOMIN_DOCTOR_2_API_KEY=nvapi-...
NOMIN_DOCTOR_3_API_KEY=nvapi-...
NOMIN_DOCTOR_4_API_KEY=nvapi-...
NOMIN_DOCTOR_5_API_KEY=nvapi-...
NOMIN_DOCTOR_6_API_KEY=nvapi-...

# Backend identifiers. These name the vendor and base model behind each Nomin
# product name, so they live here rather than in the source: a public
# repository that spells them out tells everyone exactly what Trion is.
NOMIN_BASE_URL=https://your-provider.example/v1
NOMIN_WORKER_MODEL=vendor/worker-model-id
NOMIN_VISION_MODEL=vendor/vision-model-id
NOMIN_DOCTOR_1_MODEL=vendor/model-id
NOMIN_DOCTOR_2_MODEL=vendor/model-id
NOMIN_DOCTOR_3_MODEL=vendor/model-id
NOMIN_DOCTOR_4_MODEL=vendor/model-id
NOMIN_DOCTOR_5_MODEL=vendor/model-id
NOMIN_DOCTOR_6_MODEL=vendor/model-id
