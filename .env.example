# Trion environment template. Copy to .env.local and fill in.
# NEVER commit real keys. Server-side only; no NEXT_PUBLIC_* model keys.
# (Firebase/login keys were removed with the login system and must not be re-added.)

# --- Hosted provider lane (OpenAI-compatible, default: NVIDIA integrate API) ---
# Single-key setups: set TRION_API_KEY (numbered keys below are read ONLY when
# the pool is explicitly enabled + acknowledged with the two flags).
TRION_API_KEY=
#TRION_API_KEY_1=
#TRION_API_KEY_2=
#TRION_API_KEY_3=
#TRION_API_KEYS=
#TRION_KEY_POOL_ENABLED=1
#TRION_KEY_POOL_TOS_CONFIRMED=1
TRION_BASE_URL=https://integrate.api.nvidia.com/v1
TRION_MODEL_PRIMARY=
TRION_MODEL_FAST=
# Optional extra tiers (unavailable unless each names its own primary model):
#TRION_MODEL_1_9_PRIMARY=
#TRION_MODEL_1_9_FAST=
#TRION_MODEL_2_3_PRIMARY=
#TRION_MODEL_2_3_FAST=
# Optional role routing (defaults to the user-selected tier):
#TRION_PLANNER_TIER=
#TRION_EXECUTOR_TIER=
#TRION_VERIFIER_TIER=

# --- Rate / transport budgets (defaults shown) ---
TRION_RPM_LIMIT=40
TRION_TPM_LIMIT=0
TRION_MIN_RPM=4
TRION_REQUEST_TIMEOUT_MS=180000
TRION_GEMINI_REQUEST_TIMEOUT_MS=180000
TRION_CLIENT_EXECUTION_TIMEOUT_MS=45000
TRION_CLIENT_EXECUTION_MAX_MS=180000
TRION_CIRCUIT_OPEN_MS=60000

# --- Optional internal build lane (Gemini). Key 1 plans, key 2 executes/reviews. ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
#GEMINI_API_KEY_3=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_EXECUTOR=gemini-3.5-flash
GEMINI_RPM_LIMIT=10
GEMINI_TPM_LIMIT=0
TRION_GEMINI_REQUEST_TIMEOUT_MS=180000

# --- Product / ops flags ---
# balanced | permissive | strict (see lib/agent/approval.ts)
TRION_APPROVAL_PROFILE=balanced
#TRION_DESIGN_REVIEW=1
#TRION_PERF=1
#TRION_BENCH=1
